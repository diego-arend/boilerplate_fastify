# ==============================================
# API ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================
# 
# Copy this file to:
# - .env.api.development (for development)
# - .env.api.production (for production)
#
# ==============================================

# Environment (required: 'development', 'production', or 'test')
NODE_ENV=development

# Server Configuration (required)
PORT=3001

# Worker Mode (ALWAYS false for API containers)
WORKER_MODE=false

# Worker Configuration (unused in API mode, but validated)
WORKER_CONCURRENCY=5
WORKER_PROCESSING_INTERVAL=5000
QUEUE_NAME=app-queue

# Batch Control Parameters (shared between API and Workers)
BATCH_SIZE_JOBS=50
WORKER_SIZE_JOBS=10

# ==============================================
# SECURITY CONFIGURATION
# ==============================================

# JWT Secret (required: minimum 32 characters for security)
# Generate a strong random string for production!
JWT_SECRET=your-super-secret-jwt-key-here-must-be-at-least-32-chars

# ==============================================
# DATABASE CONFIGURATION
# ==============================================

# MongoDB Configuration (required)
MONGO_URI=mongodb://admin:password@localhost:27017/boilerplate?authSource=admin

# ==============================================
# CACHE CONFIGURATION
# ==============================================

# Redis Configuration (required for caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Queue Redis Configuration (required for job queuing)
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=1

# ==============================================
# EMAIL CONFIGURATION
# ==============================================

# SMTP Email Configuration (required for production)
# For development, you can use Mailpit (mailpit service)

# SMTP Server Settings
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=Your App Name
EMAIL_TLS_REJECT_UNAUTHORIZED=false

# ==============================================
# WHATSAPP INTEGRATION (Evolution API)
# ==============================================

# Evolution API Configuration (required for WhatsApp integration)
# Get your API key from your Evolution API instance
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=B6D711FCDE4D4FD5936544120E713976
EVOLUTION_INSTANCE=desenvolvimento

# ==============================================
# EVOLUTION API DOCKER CONFIGURATION
# ==============================================
# These variables are used when running Evolution API via Docker Compose

# Evolution API Server Settings
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_PHONE_CLIENT=Evolution API
EVOLUTION_PHONE_NAME=Development
EVOLUTION_QRCODE_LIMIT=5

# Evolution API Database Configuration
EVOLUTION_DATABASE_URI=postgresql://evolution:evolution_password@localhost:5433/evolution_api
EVOLUTION_DB_USER=evolution
EVOLUTION_DB_PASSWORD=evolution_password
EVOLUTION_DB_NAME=evolution_api
EVOLUTION_DB_PORT=5433

# Evolution API S3/MinIO Configuration
EVOLUTION_S3_ACCESS_KEY=minioadmin
EVOLUTION_S3_SECRET_KEY=minioadmin
EVOLUTION_S3_BUCKET=evolution

# Evolution API Webhook Configuration (optional)
EVOLUTION_WEBHOOK_URL=http://localhost:3001/api/whatsapp/webhook
EVOLUTION_WEBHOOK_ENABLED=false

# Evolution API RabbitMQ Configuration (optional)
EVOLUTION_RABBITMQ_ENABLED=false

# ==============================================
# OPTIONAL CONFIGURATIONS
# ==============================================

# Optional advanced settings
HOST=0.0.0.0
REDIS_DB=0
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=
QUEUE_REDIS_DB=1
LOG_LEVEL=info
CORS_ORIGIN=
CORS_ALLOW_CREDENTIALS=false
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
CACHE_DEFAULT_TTL=300
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_POOL=false
EMAIL_MAX_CONNECTIONS=5
EMAIL_MAX_MESSAGES=100